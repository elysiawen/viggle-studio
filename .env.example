# ---- 数据库 ----
# SQLite 文件路径相对 prisma/schema.prisma 所在目录
DATABASE_URL="file:./viggle-studio.db"

# ---- 凭据加密 ----
# 64 位十六进制字符串（32 字节）。生成方式：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 更换此值会导致已加密的 JWT 全部无法解密，请妥善备份。
CREDENTIALS_KEY="replace-with-64-hex-chars"

# ---- Viggle 上游 ----
VIGGLE_BASE_URL="https://viggle.ai"
VIGGLE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
VIGGLE_SIGN_SALT="qdsnfXVFGS1dVCYTju"
VIGGLE_REQUEST_TIMEOUT_MS="60000"
VIGGLE_UPLOAD_TIMEOUT_MS="120000"

# ---- 任务轮询守护 ----
TASK_POLL_INTERVAL_MS="4000"
TASK_POLL_MAX_AGE_MS="900000"

# ---- 视频落盘 ----
# 落盘目录在设置页配置（默认项目根目录下的 storage/，首次读取时写入数据库）。
# 落盘加密主密码（Sakura Encryptor / .ske 容器）。留空则加密功能不可用；
# 填了之后可在设置页切换是否加密落盘（开关存在数据库 Setting 表）。
STORAGE_PASSWORD=""

# ---- 访问密码（可选）----
# 设置后打开页面需要先输入该密码；留空或不设置则不启用登录。
ACCESS_PASSWORD=""
