generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 一个 Viggle 上游账号。JWT 永远以 AES-256-GCM 密文落库，绝不存明文。
model Account {
  id            String    @id @default(uuid())
  label         String
  email         String?
  nickname      String?
  tokenCipher   String
  /// 续期用的登录邮箱（与上游返回的 email 分开存）
  loginEmail    String?
  /// 续期用的登录密码，同样以 AES-256-GCM 密文落库
  passwordCipher String?
  isActive      Boolean   @default(false)
  status        String    @default("unknown") // unknown | valid | invalid
  lastCheckedAt DateTime?
  freeCredits   Int?
  /// 积分不足时记录的下次刷新时刻；在此之前自动选号不再请求上游校验
  creditsResetAt DateTime?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tasks         Task[]
  assets        Asset[]

  @@index([isActive])
}

/// 上传到上游的素材。url / coverUrl 为临时地址（约 2 小时），仅作短期预览。
model Asset {
  id           String      @id @default(uuid())
  remoteId     String
  accountId    String
  kind         String // image | video | audio
  mime         String
  filename     String
  url          String?
  coverUrl     String?
  /// 对应的本地素材箱文件；删除本地素材时置空，不影响历史任务
  localAssetId String?
  createdAt    DateTime    @default(now())
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  localAsset   LocalAsset? @relation(fields: [localAssetId], references: [id], onDelete: SetNull)
  usedIn       TaskAsset[]

  @@index([accountId])
  @@index([accountId, localAssetId])
}

/// 本地素材箱：用户上传过的图片 / 视频，按内容哈希去重后落盘。
model LocalAsset {
  id           String   @id @default(uuid())
  /// 磁盘文件名：<sha256>.<ext>
  filename     String
  /// 用户上传时的原始文件名
  originalName String
  mime         String
  kind         String // image | video
  size         Int
  sha256       String   @unique
  /// 落盘时的存储根目录快照（绝对路径）
  storageDir   String
  /// 临时素材：不展示在素材箱，提交生成时上传到上游后即删除
  temporary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  assets       Asset[]

  @@index([createdAt])
  @@index([temporary])
}

/// 一次生成任务。历史与状态按账号隔离。
model Task {
  id           String      @id @default(uuid())
  remoteId     String?
  accountId    String
  mode         String // references | frames | text
  prompt       String
  aspectRatio  String
  duration     Int
  resolution   String
  qualityType  Int
  status       String      @default("queued") // queued | running | succeeded | failed
  stage        String      @default("submitted")
  progress     Int         @default(0)
  errorMessage String?
  videoUrl     String?
  coverUrl     String?
  remoteStatus Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  finishedAt   DateTime?
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assets       TaskAsset[]

  @@index([accountId, createdAt])
  @@index([status])
}

/// 任务与素材的多对多关系，并记录素材在任务里的角色。
model TaskAsset {
  taskId   String
  assetId  String
  role     String // reference | first | last
  position Int    @default(0)
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([taskId, assetId, role])
}

/// 用户自己保存的提示词预设，可拖动排序，未排序时按创建时间倒序展示。
model PromptPreset {
  id        String   @id @default(uuid())
  /// 预设标题；留空时由内容首行自动生成
  title     String   @default("")
  content   String
  /// 手动拖动排序的位置，越小越靠前；全为 0 时回落到按创建时间倒序
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 应用级键值配置（如当前激活账号、Provider 覆盖等）。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 已落盘到本地的视频副本。列表完全以这张表为准，不扫磁盘。
/// 刻意不建 Task 外键：删任务不删本地记录，删本地记录也不删任务。
model LocalVideo {
  /// 与 Task.id 相同，一个任务只保留一份本地副本
  taskId        String    @id
  /// 磁盘文件名：未加密为 `<taskId>.mp4`，加密后为 `<taskId>.mp4.ske`
  filename      String
  /// 文件字节数（加密时是密文大小），列表直接展示
  size          Int
  savedAt       DateTime  @default(now())
  /// 视频是否以 SKE（Sakura Encryptor）格式加密存放
  encrypted     Boolean   @default(false)
  /// 封面文件名（存在 `VIDEO_STORAGE_DIR/covers` 下）；上游没有封面时为 null
  coverFilename String?
  coverSize     Int?
  /// 封面是否加密
  coverEncrypted Boolean  @default(false)
  /// 落盘时的存储根目录快照（绝对路径）。切换目录后旧文件仍按原目录读取。
  storageDir    String
  // ---- 落盘时一并快照的记录信息，历史记录被删后仍然可读 ----
  /// 上游 Viggle 任务 ID（方便回查）
  remoteId      String?
  prompt        String
  mode          String
  accountId     String
  accountLabel  String
  aspectRatio   String
  duration      Int
  resolution    String
  qualityType   Int
  status        String
  taskCreatedAt DateTime
  finishedAt    DateTime?

  @@index([savedAt])
}
